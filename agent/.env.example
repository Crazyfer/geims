# Copy to .env and fill in. .env is gitignored.

# Discord bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_BOT_TOKEN=

# Comma-separated channel IDs the bot will listen on. Enable Developer Mode in
# Discord (Settings -> Advanced) and right-click channels -> Copy Channel ID.
DISCORD_ALLOWED_CHANNEL_IDS=

# Comma-separated Discord user IDs allowed to issue commands (you).
DISCORD_ALLOWED_USER_IDS=

# Optional: Discord role ID; members with this role are also allowed.
DISCORD_ALLOWED_ROLE_IDS=

# Absolute path to the worktree the agent operates inside.
# Set up once with: powershell agent/setup_worktree.ps1
AGENT_WORKTREE=C:\Users\Christoff\geims\zozkoputo-agent

# Max wall-clock seconds for a single agent run.
AGENT_TIMEOUT_SECONDS=300

# Optional: path to the claude CLI binary (defaults to "claude" on PATH).
CLAUDE_BIN=claude

# Optional: model hint passed to the CLI (defaults to "sonnet").
CLAUDE_MODEL=sonnet

# Godot executable path (used by tools/run_tests.py).
# Set this if Godot is not on PATH.
GODOT_BIN=
